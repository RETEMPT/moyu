root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.bat]
end_of_line = crlf

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[entry/src/main/resources/rawfile/offline-pdf/**]
trim_trailing_whitespace = false
